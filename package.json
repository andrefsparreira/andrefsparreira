{
  "name": "ks-avencas",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/migrate.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "seed:reset": "tsx src/scripts/seed.ts --reset",
    "check:pricing": "tsx src/lib/pricing.check.ts",
    "check:avencas": "tsx src/lib/avenca-motor.check.ts",
    "prebuild": "tsx src/lib/pricing.check.ts && tsx src/lib/avenca-motor.check.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@react-pdf/renderer": "4.3.2",
    "next": "^15.5.4",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "overrides": {
    "@react-pdf/hyphenate": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
